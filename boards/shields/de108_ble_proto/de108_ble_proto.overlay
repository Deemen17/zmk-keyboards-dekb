#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <dt-bindings/led/led.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,underglow = &led_strip;
        zmk,battery = &vbatt;
        zmk,physical-layout = &layout_fullsize;
    };

    /* ================= MATRIX ================= */

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        wakeup-source;
        diode-direction = "col2row";

        /* 18 columns via 74HC595 */
        col-gpios
            = <&shifter 0 GPIO_ACTIVE_LOW>
            , <&shifter 1 GPIO_ACTIVE_LOW>
            , <&shifter 2 GPIO_ACTIVE_LOW>
            , <&shifter 3 GPIO_ACTIVE_LOW>
            , <&shifter 4 GPIO_ACTIVE_LOW>
            , <&shifter 5 GPIO_ACTIVE_LOW>
            , <&shifter 6 GPIO_ACTIVE_LOW>
            , <&shifter 7 GPIO_ACTIVE_LOW>
            , <&shifter 8 GPIO_ACTIVE_LOW>
            , <&shifter 9 GPIO_ACTIVE_LOW>
            , <&shifter 10 GPIO_ACTIVE_LOW>
            , <&shifter 11 GPIO_ACTIVE_LOW>
            , <&shifter 12 GPIO_ACTIVE_LOW>
            , <&shifter 13 GPIO_ACTIVE_LOW>
            , <&shifter 14 GPIO_ACTIVE_LOW>
            , <&shifter 15 GPIO_ACTIVE_LOW>
            , <&shifter 16 GPIO_ACTIVE_LOW>
            , <&shifter 17 GPIO_ACTIVE_LOW>
            , <&shifter 18 GPIO_ACTIVE_LOW>
            , <&shifter 19 GPIO_ACTIVE_LOW>
            , <&shifter 20 GPIO_ACTIVE_LOW>
            ;

        /* 6 rows (GPIO trực tiếp) */
        row-gpios
            = <&gpio0 30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 2  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 9  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    /* ================= MATRIX TRANSFORM ================= */

matrix_transform_fullsize_108_normal: matrix_transform_fullsize_108_normal {
    compatible = "zmk,matrix-transform";
    columns = <21>;
    rows = <6>;
    map = <

    /*  esc     f1      f2      f3      f4      f5      f6      f7      f8      f9      f10      f11      f12      f13                  prt      scr      pause         calc     mute     voldn    volup  */
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)             RC(0,14) RC(0,15) RC(0,16)      RC(0,17) RC(0,18) RC(0,19) RC(0,20)

    /*  `       1       2       3       4       5       6       7       8       9       0        -        =        bs       bs          ins      home     pgup          num      /        *        -      */
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(3,12)    RC(1,14) RC(1,15) RC(1,16)      RC(1,17) RC(1,18) RC(1,19) RC(1,20)

    /*  tab     q       w       e       r       t       y       u       i       o       p        [        ]        \                    del      end      pgdn          7        8        9        +       */
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)             RC(2,14) RC(2,15) RC(2,16)      RC(2,17) RC(2,18) RC(2,19) RC(2,20)

    /*  caps    a       s       d       f       g       h       j       k       l       ;        '                 enter                                                4        5        6        +       */
        RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)          RC(3,13)                                             RC(3,17) RC(3,18) RC(3,19) RC(3,20)

    /*  lshift  nubs    z       x       c       v       b       n       m       ,       .        /        rshift   rshift                        up                     1        2        3        enter   */
        RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)                      RC(4,14)               RC(4,17) RC(4,18) RC(4,19) RC(4,20)

    /*  lctrl   lwin    lalt                            space                           ralt     menu     fn       rctrl                left     down     right         0        0        dot      enter   */
        RC(5,0) RC(5,1) RC(5,2)                         RC(5,6)                         RC(5,10) RC(5,11) RC(5,12) RC(5,13)             RC(5,14) RC(5,15) RC(5,16)      RC(5,17) RC(5,18) RC(5,19) RC(5,20)

    >;
};

matrix_transform_fullsize_108_duplex: matrix_transform_fullsize_108_duplex {
    compatible = "zmk,matrix-transform";
    columns = <11>;
    rows = <12>;
    map = <

    /*  esc      f1       f2      f3      f4      f5      f6      f7      f8      f9      f10      f11      f12      f13      prt     scr     pause        calc     mute     voldn     volup  */
        RC(0,0)  RC(1,0)  RC(0,1) RC(1,1) RC(0,2) RC(1,2) RC(0,3) RC(1,4) RC(0,4) RC(1,5) RC(0,5) RC(1,6) RC(0,6) RC(1,7)     RC(0,7) RC(1,8) RC(0,8)      RC(1,9)  RC(0,9)  RC(1,10)  RC(0,10)

    /*  `        1        2       3       4       5       6       7       8       9       0       -        =      bs          ins     home    pgup         num      /        *         -      */
        RC(2,0)  RC(3,0)  RC(2,1) RC(3,1) RC(2,2) RC(3,2) RC(2,3) RC(3,4) RC(2,4) RC(3,5) RC(2,5) RC(3,6) RC(2,6) RC(3,7)     RC(2,7) RC(3,8) RC(2,8)      RC(3,9)  RC(2,9)  RC(3,10)  RC(2,10)

    /*  tab      q        w       e       r       t       y       u       i       o       p       [        ]      bs          del     end     pgdn         7        8        9         +       */
        RC(4,0)  RC(5,0)  RC(4,1) RC(5,1) RC(4,2) RC(5,2) RC(4,3) RC(5,4) RC(4,4) RC(5,5) RC(4,5) RC(5,6) RC(4,6) RC(5,7)     RC(4,7) RC(5,8) RC(4,8)      RC(5,9)  RC(4,9)  RC(5,10)  RC(4,10)

    /*  caps     a        s       d       f       g       h       j       k       l       ;        '       \      enter                                    4        5        6         +       */
        RC(6,0)  RC(7,0)  RC(6,1) RC(7,1) RC(6,2) RC(7,2) RC(6,3) RC(7,4) RC(6,4) RC(7,5) RC(6,5) RC(7,6) RC(6,6) RC(7,7)                                  RC(7,9)  RC(6,9)  RC(7,10)  RC(6,10)

    /*  lshift   nubs     z       x       c       v       b       n       m       ,       .        /      rshift  rshift              up                   1        2        3         enter   */
        RC(8,0)  RC(9,0)  RC(8,1) RC(9,1) RC(8,2) RC(9,2) RC(8,3) RC(9,4) RC(8,4) RC(9,5) RC(8,5) RC(9,6) RC(8,6) RC(9,7)             RC(9,8)              RC(9,9)  RC(8,9)  RC(9,10)  RC(8,10)

    /*  lctrl    lwin     lalt                            space                           ralt     menu     fn       rctrl    left     down     right      0        0        dot       enter   */
        RC(10,0) RC(11,0) RC(10,1)                        RC(10,3)                        RC(10,5) RC(11,6) RC(10,6) RC(11,7) RC(10,7) RC(11,8) RC(10,8)   RC(11,9) RC(10,9) RC(11,10) RC(10,10)

    >;
};


    /* ================= BATTERY ================= */

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 0>;
        output-ohms = <470000>;
        full-ohms = <(470000 + 1000000)>;
    };
};

/* ================= SPI ================= */

&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    sck-pin = <3>;     /* P0.03 */
    mosi-pin = <28>;   /* dummy nếu cần */
    miso-pin = <255>;

    cs-gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;

    shifter: 595@0 {
        compatible = "zmk,gpio-595";
        status = "okay";
        gpio-controller;

        spi-max-frequency = <8000000>;
        reg = <0>;
        #gpio-cells = <2>;
        ngpios = <24>; /* đủ cho 18 col */
    };
};

/* ================= WS2812 ================= */

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;

        spi-max-frequency = <4000000>;
        chain-length = <10>;

        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

/* ================= LAYOUT ================= */

/ {
    layout_fullsize: layout_fullsize {
        compatible = "zmk,physical-layout";
        display-name = "FULLSIZE_104";
        transform = <&matrix_transform_fullsize_108_normal>;
    };
};
