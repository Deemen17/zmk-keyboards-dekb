#include <dt-bindings/zmk/matrix_transform.h>

#define MAP_R0_BS_2U        RC(0,0) RC(1,0) RC(0,1) RC(1,1) RC(0,2) RC(1,2) RC(0,3) RC(1,3) RC(0,4) RC(1,4) RC(0,5) RC(1,5) RC(0,6) RC(1,6) 
#define MAP_R0_BS_1U        MAP_R0_BS_2U RC(5,6) 

#define MAP_R1              RC(2,0) RC(3,0) RC(2,1) RC(3,1) RC(2,2) RC(3,2) RC(2,3) RC(3,3) RC(2,4) RC(3,4) RC(2,5) RC(3,5) RC(2,6) RC(3,6) 

#define MAP_R2              RC(4,0) RC(5,0) RC(4,1) RC(5,1) RC(4,2) RC(5,2) RC(4,3) RC(5,3) RC(4,4) RC(5,4) RC(4,5) RC(5,5)         RC(4,6) 

#define WHT_MAP_R3_ISO_L    RC(6,0) RC(7,0) RC(6,1) RC(7,1) RC(6,2) RC(7,2) RC(6,3) RC(7,3) RC(6,4) RC(7,4) RC(6,5) RC(7,5)
#define MAP_R3_ISO_L WHT_MAP_R3_ISO_L
#define MAP_R3_ANSI_L       RC(6,0)         RC(6,1) RC(7,1) RC(6,2) RC(7,2) RC(6,3) RC(7,3) RC(6,4) RC(7,4) RC(6,5) RC(7,5)

#define MAP_R3_R            RC(6,6) RC(7,6) 
#define WHT_MAP_R3_R_275U   RC(6,6) 

#define MAP_R4_ALL_L        RC(8,0) RC(9,0) RC(8,1)                         RC(9,3)       
#define MAP_R4_HHKB_L               RC(9,0) RC(8,1)                         RC(9,3)       
#define MAP_R4_WKL_L        RC(8,0)         RC(8,1)                         RC(9,3)     

