#define MAP_R4_10U_wKL_L    RC(8,0)                                         RC(9,3)       

// Space 625u arrow
#define WHT_MAP_R4_625U_A   RC(8,4) RC(9,5) RC(8,5) RC(9,6) RC(8,6) 
// Space 625u universal
#define WHT_MAP_R4_625U_U   RC(8,4) RC(9,5)         RC(9,6) RC(8,6) 
// Space 625u hhkb
