CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_DE60_BLE_REV1=y

CONFIG_ARM_MPU=y
CONFIG_PINCTRL=y
CONFIG_GPIO=y
CONFIG_LED=y
CONFIG_LED_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

# USB
CONFIG_ZMK_USB=y
CONFIG_USB_DEVICE_VID=0xDE17
CONFIG_USB_DEVICE_PID=0x60B1
CONFIG_USB_DEVICE_MANUFACTURER="DEKB"
CONFIG_ZMK_KEYBOARD_NAME="DE60 BLE REV1"
CONFIG_USB_DEVICE_SN="dekb.com:DE60-0123456789ABCDEF"
CONFIG_ZMK_HID_REPORT_TYPE_NKRO=y

# BLE
CONFIG_ZMK_BLE=y
CONFIG_BT_DEVICE_NAME_MAX=23
CONFIG_BT_DEVICE_NAME="DE60 BLE REV1"
CONFIG_ZMK_BLE_EXPERIMENTAL_CONN=y
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

CONFIG_BT_DIS_PNP_PID=0xDE17
CONFIG_BT_DIS_PNP_VID=0x60B1
CONFIG_BT_DIS_MANUF="DEKB"
CONFIG_BT_DIS_MODEL="DE60 BLE REV1"

CONFIG_BT_CTLR_DATA_LENGTH_MAX=251
CONFIG_BT_BUF_ACL_TX_SIZE=251
CONFIG_BT_BUF_ACL_RX_SIZE=251
CONFIG_BT_L2CAP_TX_MTU=247
CONFIG_BT_GATT_AUTO_UPDATE_MTU=y

CONFIG_HEAP_MEM_POOL_SIZE=32768
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=4096
CONFIG_ZMK_STUDIO_RPC_THREAD_STACK_SIZE=8192

# BLE TX queue + Studio RPC buffer
CONFIG_BT_L2CAP_TX_BUF_COUNT=10
CONFIG_ZMK_STUDIO_RPC_TX_BUF_SIZE=256

# Enable BLE experimental features
CONFIG_ZMK_BLE_EXPERIMENTAL_FEATURES=y
CONFIG_ZMK_BLE_PASSKEY_ENTRY=y

# POWER MANAGEMENT
# Low Power States - Go to idle after 2 mins (2*60*1000ms)
CONFIG_ZMK_IDLE_TIMEOUT=120000
CONFIG_ZMK_IDLE_SKIP_ON_USB_POWER=y

# Low Power States - Go to sleep after 30 mins (30*60*1000ms)
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=1800000
CONFIG_ZMK_SLEEP=y

# Soft Off
CONFIG_ZMK_PM_SOFT_OFF=y

# HID
# CONFIG_ZMK_HID_CONSUMER_REPORT_USAGES_FULL=y
CONFIG_ZMK_HID_CONSUMER_REPORT_USAGES_BASIC=y
CONFIG_ZMK_HID_INDICATORS=y

# DEBOUNCE
CONFIG_ZMK_KSCAN_DEBOUNCE_PRESS_MS=3
CONFIG_ZMK_KSCAN_DEBOUNCE_RELEASE_MS=5

# STUDIO
CONFIG_ZMK_STUDIO=y
CONFIG_ZMK_STUDIO_LOCKING=n
CONFIG_ZMK_STUDIO_LOCK_ON_DISCONNECT=n

# RGB UNDERGLOW
CONFIG_ZMK_RGB_UNDERGLOW=y
CONFIG_WS2812_STRIP=y
CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER=y
CONFIG_ZMK_RGB_UNDERGLOW_AUTO_OFF_USB=y
CONFIG_ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE=y
CONFIG_ZMK_RGB_UNDERGLOW_ON_START=y
CONFIG_ZMK_RGB_UNDERGLOW_BRT_MAX=75
CONFIG_ZMK_RGB_UNDERGLOW_BRT_START=30
CONFIG_ZMK_RGB_UNDERGLOW_SPD_START=5
CONFIG_ZMK_RGB_UNDERGLOW_EFF_START=0
CONFIG_ZMK_RGB_UNDERGLOW_HUE_START=0
CONFIG_ZMK_RGB_UNDERGLOW_SAT_START=100

# Per-key RGB Layer Effect
CONFIG_EXPERIMENTAL_RGB_LAYER=n

# Enable external power management (RGB power control via P0.27)
CONFIG_ZMK_EXT_POWER=y

# BATTERY REPORTING
CONFIG_ZMK_BATTERY=y
CONFIG_ZMK_BATTERY_REPORTING=y
CONFIG_FUEL_GAUGE=y
CONFIG_ZMK_MAX17048=y
CONFIG_BT_BAS=y

# I2C
CONFIG_I2C=y
CONFIG_I2C_NRFX=y
CONFIG_SENSOR=y
CONFIG_FUEL_GAUGE=y

# DEBUG: Enable I2C and MAX17048 debug logging (comment out for production)
# CONFIG_I2C_LOG_LEVEL_DBG=y
# CONFIG_LOG_DEFAULT_LEVEL=3
# CONFIG_LOG=y

# BUZZER (PWM) 
CONFIG_PWM=y
CONFIG_PWM_NRFX=y

# POINTING DEVICE
CONFIG_ZMK_POINTING=y
CONFIG_ZMK_POINTING_SMOOTH_SCROLLING=y
