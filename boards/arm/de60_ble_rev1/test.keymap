#include "../common.keymap"

#define VOLUP kp C_VOL_UP
#define VOLDN kp C_VOL_DN
#define VOLMU kp C_MUTE
#define PLAPS kp C_PLAY_PAUSE

/ {
    keymap {
        compatible = "zmk,keymap";

        windows {
            label = "Layer 0: Windows";
            bindings = <
&gresc    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &kp N6   &kp N7   &kp N8   &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSLH   &kp DEL
&kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSPC
&kp CAPS  &kp A    &kp S    &kp D    &kp F    &kp G    &kp H    &kp J    &kp K    &kp L     &kp SEMI  &kp SQT             &kp ENTER
&kp LSHFT &kp NUBS &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp COMMA &kp DOT   &kp FSLH  &kp UP    &mo 3
&kp LCTRL &kp LGUI &kp LALT                            &kp SPACE                  &kp RALT  &mo 2     &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        macos {
            label = "Layer 1: MacOS";
            bindings = <
&gresc    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &kp N6   &kp N7   &kp N8   &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSLH   &kp DEL
&kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSPC
&kp CAPS  &kp A    &kp S    &kp D    &kp F    &kp G    &kp H    &kp J    &kp K    &kp L     &kp SEMI  &kp SQT             &kp ENTER
&kp LSHFT &kp NUBS &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp COMMA &kp DOT   &kp FSLH  &kp UP    &mo 3
&kp LCTRL &kp LALT &kp LGUI                            &kp SPACE                  &kp RALT  &mo 2     &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        function {
            label = "Layer 2: Function";
            bindings = <
&kp GRAVE &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9    &kp F10   &kp F11   &kp F12   &trans     &trans
&trans    &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans    &trans    &trans    &trans    &trans
&trans    &VOLDN   &VOLUP   &VOLMU   &PLAPS   &trans   &kp LEFT &kp DOWN &kp UP   &kp RIGHT &kp HOME  &kp END             &trans
&trans    &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &kp PG_DN &kp PG_UP &trans    &trans    &trans
&trans    &to 0    &to 1                               &trans                     &trans    &trans    &trans    &trans    &trans
            >;
        };

        system {
            label = "Layer 3: System";
            bindings = <
&DE_OUT   &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9    &kp F10   &kp F11   &kp F12   &kp F13    &DE_BLD
&DE_USB   &DE_BT1  &DE_BT2  &DE_BT3  &trans   &trans   &trans   &trans   &trans   &trans    &trans    &trans    &UGSPD    &UGSPI
&DE_BAT   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans    &UGHUD    &UGHUI              &UGTOG
&DE_SLP   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &UGSAD    &UGSAI    &trans    &UGBRI    &trans
&trans    &to 0    &to 1                               &trans                     &trans    &trans    &UGEFF    &UGBRD    &UGEFR
            >;
        };
    };
};