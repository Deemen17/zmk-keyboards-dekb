if BOARD_DE60_BLE_REV1_REL

config BOARD
    default "de60_ble_rev1_rel"

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
	default y

config USB_DEVICE_MANUFACTURER
	default "DEKB"

endif # USB

if BT

config BT_DIS_MANUF
	default "DEKB"

config BT_DIS_MODEL
	default "DE60 BLE REV1"

endif # BT

config BT_CTLR
	default BT

config ZMK_BLE
	default y

config ZMK_USB
	default y

endif # BOARD_DE60_BLE_REV1_REL
